{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Solara-Worlds/public-news/schema/standards.schema.json",
  "title": "Solara Worlds community standards manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "updated", "title", "path"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "path": { "const": "community-standards.md" }
  }
}
