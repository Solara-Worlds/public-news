{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Solara-Worlds/public-news/schema/standards-pointer.schema.json",
  "title": "Pointer from news.json to the community standards manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "path"],
  "properties": {
    "version": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "path": { "const": "community-standards.md" }
  }
}
